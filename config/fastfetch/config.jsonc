{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
  "type": "file",
  "source": "~/.config/fastfetch/claude.txt",
  "color": {
    "1": "#EB5429"
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "#EB5429",
      "output": "#9E9BAA"
    },
    "key": {
      "width": 3,
      "type": "string"
    }
  },

  "modules": [
    {
      "type": "title",
      "key": "",
      "keyColor": "#EB5429",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "kernel",
      "key": "",
      "keyColor": "#EB5429"
    },
    {
      "type": "uptime",
      "key": "󰅐",
      "keyColor": "#D16648"
    },
    {
      "type": "packages",
      "key": "󰏖",
      "keyColor": "#D22E11"
    },
    {
      "type": "shell",
      "key": "",
      "keyColor": "#D16648"
    },
    {
      "type": "wm",
      "key": "",
      "keyColor": "#EB5429"
    },
    {
      "type": "cpu",
      "key": "󰻠",
      "keyColor": "#EB5429"
    },
    {
      "type": "gpu",
      "key": "󰢮",
      "keyColor": "#D22E11"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "#A3230E",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "",
      "keyColor": "#D16648"
    },
    {
      "type": "localip",
      "key": "󰤨",
      "keyColor": "#EB5429",
      "format": "{ipv4}"
    }
  ]
}
